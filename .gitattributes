# Keep source/protocol hashes portable across checkout platforms.
audio/learned/**/*.py text eol=lf
audio/learned/**/*.sh text eol=lf
audio/learned/**/*.json text eol=lf
audio/learned/**/*.yaml text eol=lf
audio/learned/**/*.csv text eol=lf
multimodal_fusion/configs/actor_splits.csv text eol=lf
*.pt binary

# Unified record hashes require stable text bytes
experiment_records/**/*.py text eol=lf
experiment_records/**/*.json text eol=lf
experiment_records/**/*.csv text eol=lf
experiment_records/**/*.yaml text eol=lf
experiment_records/**/*.patch text eol=lf

# Preserve original hashed evidence bytes; the protocol was supplied as CRLF.
multimodal_fusion/results/m5_final_delivery_20261027/provenance/visual_probability_protocol.json -text whitespace=cr-at-eol
*.npz binary
*.joblib binary
*.keras binary

# Preserve the exact supplied metadata bytes used by model archive checksums.
assets/model_metadata/** -text whitespace=cr-at-eol
